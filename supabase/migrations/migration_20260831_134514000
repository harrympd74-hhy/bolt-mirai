create table if not exists public.class_meetings (
  id uuid primary key default gen_random_uuid(),
  teacher_id uuid not null references public.teacher_profiles(id) on delete cascade,
  schedule_id uuid references public.class_schedules(id) on delete set null,
  meeting_number integer not null,
  class_name text not null,
  title text not null,
  starts_at timestamptz not null,
  ends_at timestamptz not null,
  status text not null default 'draft' check (status in ('draft','published','locked')),
  created_at timestamptz not null default now(),
  updated_at timestamptz not null default now(),
  constraint class_meetings_time_order check (ends_at > starts_at),
  unique (teacher_id, meeting_number)
);
create table if not exists public.meeting_materials (
  id uuid primary key default gen_random_uuid(),
  meeting_id uuid not null references public.class_meetings(id) on delete cascade,
  title text not null,
  kind text not null check (kind in ('file','link')),
  file_url text,
  file_name text,
  external_url text,
  created_at timestamptz not null default now()
);
create table if not exists public.meeting_assignments (
  id uuid primary key default gen_random_uuid(),
  meeting_id uuid not null references public.class_meetings(id) on delete cascade,
  title text not null,
  description text,
  due_at timestamptz,
  status text not null default 'open' check (status in ('open','completed')),
  created_at timestamptz not null default now()
);
alter table public.class_meetings enable row level security;
alter table public.meeting_materials enable row level security;
alter table public.meeting_assignments enable row level security;
create policy "meetings teacher admin manage" on public.class_meetings for all to authenticated using ((auth.jwt() -> 'app_metadata' ->> 'role') = 'admin' or exists (select 1 from public.teacher_accounts ta where ta.auth_user_id = auth.uid() and ta.teacher_id = class_meetings.teacher_id)) with check ((auth.jwt() -> 'app_metadata' ->> 'role') = 'admin' or exists (select 1 from public.teacher_accounts ta where ta.auth_user_id = auth.uid() and ta.teacher_id = class_meetings.teacher_id));
create policy "meetings students published read" on public.class_meetings for select to authenticated using (status = 'published' and exists (select 1 from public.student_profiles sp join public.student_accounts sa on sa.student_id = sp.id where sa.auth_user_id = auth.uid() and sp.class_name = class_meetings.class_name));
create policy "materials teacher admin manage" on public.meeting_materials for all to authenticated using ((auth.jwt() -> 'app_metadata' ->> 'role') = 'admin' or exists (select 1 from public.class_meetings cm join public.teacher_accounts ta on ta.teacher_id = cm.teacher_id where cm.id = meeting_materials.meeting_id and ta.auth_user_id = auth.uid())) with check ((auth.jwt() -> 'app_metadata' ->> 'role') = 'admin' or exists (select 1 from public.class_meetings cm join public.teacher_accounts ta on ta.teacher_id = cm.teacher_id where cm.id = meeting_materials.meeting_id and ta.auth_user_id = auth.uid()));
create policy "materials students published read" on public.meeting_materials for select to authenticated using (exists (select 1 from public.class_meetings cm join public.student_profiles sp on sp.class_name = cm.class_name join public.student_accounts sa on sa.student_id = sp.id where cm.id = meeting_materials.meeting_id and cm.status = 'published' and sa.auth_user_id = auth.uid()));
create policy "assignments teacher admin manage" on public.meeting_assignments for all to authenticated using ((auth.jwt() -> 'app_metadata' ->> 'role') = 'admin' or exists (select 1 from public.class_meetings cm join public.teacher_accounts ta on ta.teacher_id = cm.teacher_id where cm.id = meeting_assignments.meeting_id and ta.auth_user_id = auth.uid())) with check ((auth.jwt() -> 'app_metadata' ->> 'role') = 'admin' or exists (select 1 from public.class_meetings cm join public.teacher_accounts ta on ta.teacher_id = cm.teacher_id where cm.id = meeting_assignments.meeting_id and ta.auth_user_id = auth.uid()));
create policy "assignments students published read" on public.meeting_assignments for select to authenticated using (exists (select 1 from public.class_meetings cm join public.student_profiles sp on sp.class_name = cm.class_name join public.student_accounts sa on sa.student_id = sp.id where cm.id = meeting_assignments.meeting_id and cm.status = 'published' and sa.auth_user_id = auth.uid()));
create index if not exists class_meetings_class_idx on public.class_meetings(class_name, starts_at);
create index if not exists meeting_materials_meeting_idx on public.meeting_materials(meeting_id);
create index if not exists meeting_assignments_meeting_idx on public.meeting_assignments(meeting_id);